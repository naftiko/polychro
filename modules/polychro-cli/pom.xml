<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.polychro</groupId>
        <artifactId>polychro-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>polychro-cli</artifactId>
    <name>Polychro CLI</name>
    <description>Command-line interface for Polychro linting</description>

    <dependencies>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-capability</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <!--
                  Apache Groovy comes transitively (polychro-capability -> ikanos-engine) and the
                  CLI never runs it. Excluding it keeps about 7 MB out of the jar + JRE package.
                  A GraalVM polyglot Groovy language would be a direct dependency of
                  polychro-ruleset-polyglot, next to js-community, and is not affected.
                  Guarded by GroovyExclusionTest.
                -->
                <exclusion>
                    <groupId>org.apache.groovy</groupId>
                    <artifactId>groovy</artifactId>
                </exclusion>
                <!--
                  GraalPy (Truffle Python) comes transitively (polychro-capability ->
                  ikanos-engine -> org.graalvm.polyglot:python) and the CLI never runs it: the only
                  polyglot language Polychro runs is JS (polychro-ruleset-polyglot ->
                  org.graalvm.js:js-community). Excluding the org.graalvm.polyglot:python root
                  also drops python-language, python-resources, BouncyCastle and the Truffle NFI
                  and LLVM jars it pulls in, which keeps the jar + JRE package's lib/ at about
                  95 MB instead of 254 MB. JS is unaffected. Guarded by GraalPyExclusionTest.
                -->
                <exclusion>
                    <groupId>org.graalvm.polyglot</groupId>
                    <artifactId>python</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          Validator modules. Each registers a ValidatorFactory via
          META-INF/services/io.polychro.spi.ValidatorFactory and must be on
          the runtime classpath (and in the package's lib/) for
          ServiceLoader to discover it. Without these, `polychro lint`
          discovers zero validators and silently reports "No issues found."
          (see issue #20).
        -->
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-wellformedness</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-ruleset</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-ruleset-polyglot</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-rulesets</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-json-schema</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-json-structure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-markdown</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-html</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.polychro</groupId>
            <artifactId>polychro-checkov</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <!--
                  Enable Maven property filtering for version.properties so that
                  ${project.version} is substituted at build time. All other
                  resources are copied as-is.
                -->
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.polychro.cli.PolychroCli</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <exclude>io/polychro/cli/PolychroCli.class</exclude>
                                <exclude>io/polychro/cli/PolychroCli$VersionProvider.class</exclude>
                                <exclude>io/polychro/cli/ServeCommand.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profile for the jar + custom JRE package (issue #170) -->
        <profile>
            <id>jre-package</id>
            <dependencies>
                <!-- No SLF4J provider is on the classpath, so on a JVM SLF4J prints a
                     "No SLF4J providers were found" warning and drops every log, including
                     errors such as a rule function that fails to load. The package gets
                     slf4j-simple, set to warnings and errors on stderr by
                     simplelogger.properties, so a normal run stays quiet. -->
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                    <version>${slf4j.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <!-- polychro.jar, whatever the version: jreleaser.yml and install.sh name it. -->
                <finalName>polychro</finalName>
                <plugins>
                    <!--
                      Lays out target/ for jreleaser.yml, which ships every jar in one jars/ folder
                      next to a jlink runtime: polychro.jar plus every runtime dependency in lib/.
                      Not a shaded jar: the GraalJS and Truffle jars keep their module
                      descriptors only as separate jars. The jar's manifest lists the other jars by
                      name, with no folder, so "java -jar jars/polychro.jar" works on its own once
                      they sit side by side.
                      useUniqueVersions=false makes SNAPSHOT entries match the file names that
                      copy-dependencies writes (no timestamp).
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <archive>
                                <manifest>
                                    <addClasspath>true</addClasspath>
                                    <classpathPrefix></classpathPrefix>
                                    <useUniqueVersions>false</useUniqueVersions>
                                </manifest>
                            </archive>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-dependencies</id>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <phase>package</phase>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <!-- GraalJS is declared as pom-type dependencies (BOMs). -->
                                    <excludeTypes>pom</excludeTypes>
                                    <outputDirectory>${project.build.directory}/lib</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
